# Copia aquest fitxer a ".env" i omple'l. No el pugis mai a git.

# Adreces (els dos dominis han d'apuntar a la IP del teu servidor)
SITE_DOMAIN=superdotats.cat
APP_DOMAIN=app.superdotats.cat

# Contrasenya de l'usuari "admin" del panell /admin (tria'n una de llarga)
ADMIN_PASSWORD=
# Opcional: correus que seran admin quan entrin amb Google/Apple
ADMIN_EMAILS=

# 1 = qualsevol es pot crear un compte; 0 = tancat
SIGNUP_OPEN=1

# Model per defecte per a qui no posi la seva clau. Si ho deixes buit, cadascú porta la seva (recomanat al principi).
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.groq.com/openai/v1
MODEL_WIRE_API=chat
DEFAULT_MODEL=openai/gpt-oss-20b

# Inici de sessió amb Google / Apple (opcional, vegeu docs/AUTH.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
